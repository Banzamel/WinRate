{
  "name": "winrate",
  "productName": "WinRate",
  "version": "0.6.0",
  "description": "Windows desktop (Tauri) lottery lab for Lotto and Eurojackpot: full draw history, exact odds, statistics with significance tests, combination filters measured exactly, ticket generator and walk-forward simulations.",
  "type": "module",
  "author": "Rafał Polak (Banzamel)",
  "license": "MIT",
  "homepage": "https://github.com/Banzamel/WinRate#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Banzamel/WinRate.git"
  },
  "bugs": {
    "url": "https://github.com/Banzamel/WinRate/issues"
  },
  "keywords": [
    "lottery",
    "lotto",
    "eurojackpot",
    "statistics",
    "probability",
    "combinatorics",
    "simulation",
    "tauri"
  ],
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-history": "node scripts/fetch-history.mjs",
    "version:check": "node scripts/version.cjs check",
    "version": "node scripts/version.cjs stamp && git add CHANGELOG.md",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "docker:image": "docker build -t winrate-build docker",
    "dist": "npm run fetch-history && sh docker/build.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.4",
    "vitest": "^5.1.0"
  }
}
